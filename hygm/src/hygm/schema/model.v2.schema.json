{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/memgraph/ai-toolkit/hygm/schema/model.v2.schema.json",
  "title": "hygm model, format version 2",
  "description": "The structure of a version-2 hygm model file. Rules a JSON Schema can't express (unique labels and properties, declared parents and endpoints, no parent cycle, property facets and narrowing them, keys, disjointness, inverses, relation restrictions, synonyms, profile rules, resolving imports) are defined in hygm/docs/contract.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "node_types"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "node_types": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node_type"
      }
    },
    "relation_types": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation_type"
      }
    },
    "profiles": {
      "$ref": "#/$defs/model_profiles"
    },
    "ontology": {
      "$ref": "#/$defs/ontology"
    },
    "imports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/import"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "labels": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "node_type": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "description"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/identifier"
        },
        "description": {
          "type": "string"
        },
        "parents": {
          "$ref": "#/$defs/labels"
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/property"
          }
        },
        "key": {
          "$ref": "#/$defs/labels"
        },
        "iri": {
          "type": "string"
        },
        "profiles": {
          "$ref": "#/$defs/node_profiles"
        },
        "abstract": {
          "type": "boolean"
        },
        "disjoint_with": {
          "$ref": "#/$defs/labels"
        },
        "synonyms": {
          "$ref": "#/$defs/strings"
        },
        "names": {
          "$ref": "#/$defs/names"
        },
        "relation_restrictions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relation_restriction"
          }
        }
      }
    },
    "relation_type": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "description"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/identifier"
        },
        "description": {
          "type": "string"
        },
        "start_labels": {
          "$ref": "#/$defs/labels"
        },
        "end_labels": {
          "$ref": "#/$defs/labels"
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/property"
          }
        },
        "iri": {
          "type": "string"
        },
        "profiles": {
          "$ref": "#/$defs/relation_profiles"
        },
        "synonyms": {
          "$ref": "#/$defs/strings"
        },
        "names": {
          "$ref": "#/$defs/names"
        },
        "min_count": {
          "type": "integer",
          "minimum": 0
        },
        "max_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "inverse_of": {
          "$ref": "#/$defs/identifier"
        },
        "symmetric": {
          "type": "boolean"
        }
      }
    },
    "property": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "enum": [
            "string",
            "integer",
            "float",
            "decimal",
            "boolean",
            "date",
            "datetime",
            "json"
          ]
        },
        "description": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "iri": {
          "type": "string"
        },
        "profiles": {
          "$ref": "#/$defs/property_profiles"
        },
        "synonyms": {
          "$ref": "#/$defs/strings"
        },
        "names": {
          "$ref": "#/$defs/names"
        },
        "min_count": {
          "type": "integer",
          "minimum": 0
        },
        "max_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "default": {},
        "value": {},
        "minimum": {
          "type": [
            "number",
            "string"
          ]
        },
        "maximum": {
          "type": [
            "number",
            "string"
          ]
        },
        "unit": {
          "type": "string"
        }
      },
      "if": {
        "required": [
          "values"
        ]
      },
      "then": {
        "properties": {
          "type": {
            "const": "string"
          }
        }
      }
    },
    "model_profiles": {
      "type": "object",
      "propertyNames": {
        "anyOf": [
          {
            "enum": [
              "extraction",
              "conversation",
              "learning"
            ]
          },
          {
            "pattern": "^x_"
          }
        ]
      },
      "additionalProperties": {
        "type": "object"
      },
      "properties": {
        "extraction": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        },
        "conversation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "speaker": {
              "$ref": "#/$defs/identifier"
            },
            "other_person": {
              "$ref": "#/$defs/identifier"
            }
          }
        },
        "learning": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        }
      }
    },
    "node_profiles": {
      "type": "object",
      "propertyNames": {
        "anyOf": [
          {
            "enum": [
              "extraction",
              "conversation",
              "learning"
            ]
          },
          {
            "pattern": "^x_"
          }
        ]
      },
      "additionalProperties": {
        "type": "object"
      },
      "properties": {
        "extraction": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "identity": {
              "enum": [
                "global",
                "chunk",
                "span"
              ]
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        "conversation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        },
        "learning": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "protected": {
              "type": "boolean"
            },
            "catch_all": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "relation_profiles": {
      "type": "object",
      "propertyNames": {
        "anyOf": [
          {
            "enum": [
              "extraction",
              "conversation",
              "learning"
            ]
          },
          {
            "pattern": "^x_"
          }
        ]
      },
      "additionalProperties": {
        "type": "object"
      },
      "properties": {
        "extraction": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        },
        "conversation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        },
        "learning": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        }
      }
    },
    "property_profiles": {
      "type": "object",
      "propertyNames": {
        "anyOf": [
          {
            "enum": [
              "extraction",
              "conversation",
              "learning"
            ]
          },
          {
            "pattern": "^x_"
          }
        ]
      },
      "additionalProperties": {
        "type": "object"
      },
      "properties": {
        "extraction": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        },
        "conversation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        },
        "learning": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        }
      }
    },
    "ontology": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "iri": {
          "type": "string"
        },
        "version_info": {
          "type": "string"
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "includes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "excludes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "competency_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "maintainers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conventions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "node_case": {
              "enum": [
                "upper_camel",
                "lower_camel",
                "snake",
                "upper_snake"
              ]
            },
            "property_case": {
              "enum": [
                "upper_camel",
                "lower_camel",
                "snake",
                "upper_snake"
              ]
            },
            "relation_case": {
              "enum": [
                "upper_camel",
                "lower_camel",
                "snake",
                "upper_snake"
              ]
            },
            "number": {
              "enum": [
                "singular",
                "plural"
              ]
            }
          }
        }
      }
    },
    "import": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "strings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "names": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "relation_restriction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation"
      ],
      "properties": {
        "relation": {
          "$ref": "#/$defs/identifier"
        },
        "end_labels": {
          "$ref": "#/$defs/labels"
        },
        "min_count": {
          "type": "integer",
          "minimum": 0
        },
        "max_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
